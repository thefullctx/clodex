index 0000000000..3553eed0eb
--- /dev/null
+++ b/apps/desktop/src/lib/inline-code.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from 'vitest'
+
+import { classifyInlineCode } from './inline-code'
+
+describe('classifyInlineCode', () => {
+  it('reads shell commands and leading assignments', () => {
+    for (const text of ['npm run pack', 'git status', 'gh pr create', 'cd apps/desktop', 'ABLIT=1', 'HF_TOKEN=abc']) {
+      expect(classifyInlineCode(text)).toBe('shell')
+    }
+  })
+
+  it('reads runnable script paths as shell, not as files', () => {
+    expect(classifyInlineCode('./start.sh')).toBe('shell')
+    expect(classifyInlineCode('../tools/run.py')).toBe('shell')
+  })
+
+  it('reads filesystem paths', () => {
+    expect(classifyInlineCode('~/Projects/hermes/apps/desktop')).toBe('path')
+    expect(classifyInlineCode('src/app/chat/index.tsx')).toBe('path')
+    expect(classifyInlineCode('/usr/local/bin')).toBe('path')
+    expect(classifyInlineCode('~/bin/run')).toBe('path')
+  })
+
+  it('reads model names and HF cache directories', () => {
+    expect(classifyInlineCode('models--drowzeys--keys--house-qsa-L3-47')).toBe('model')
+    expect(classifyInlineCode('Qwen3.8-Flash-Next')).toBe('model')
+    expect(classifyInlineCode('gpt-4o-mini')).toBe('model')
+  })
+
+  it('reads long ids, hashes and prefixed keys', () => {
+    expect(classifyInlineCode('ablit-b9ce18a6-c44f5b92')).toBe('token')
+    expect(classifyInlineCode('9f2b7c1e4d8a6350')).toBe('token')
+    expect(classifyInlineCode('ghp_1234567890abcdefghij')).toBe('token')
+  })
+
+  // The whole point of a conservative table: ordinary words must stay plain, or
+  // every paragraph turns into confetti.
+  it('leaves prose and bare words plain', () => {
+    for (const text of ['ornith', 'some_value', 'the config', 'true', 'ok', 'Hermes', '2']) {
+      expect(classifyInlineCode(text)).toBe('plain')
+    }
+  })
+
+  it('leaves command flags and short paths with spaces alone', () => {
+    expect(classifyInlineCode('--force')).toBe('plain')
+    expect(classifyInlineCode('a / b')).toBe('plain')
+  })
+})
diff --git a/apps/desktop/src/lib/inline-code.ts b/apps/desktop/src/lib/inline-code.ts
new file mode 100644
index 0000000000..cf39bae790
--- /dev/null
+++ b/apps/desktop/src/lib/inline-code.ts
@@ -0,0 +1,86 @@
+/**
+ * What an inline `code` span looks like, decided from the text alone.
+ *
+ * Markdown gives us a bare string — no idea whether it came from a terminal
+ * call, a file listing, or a model id — so this is a heuristic, and it is
+ * deliberately conservative: a wrong guess costs a hue, and every rule below is
+ * anchored so ordinary words stay plain.
+ *
+ * The kind drives colour AND glyph (see styles.css `[data-code-kind]`). The
+ * glyph is a CSS mask on ::before, never a child element: a real <i> inside a
+ * code span would ride along into a copy, and inline code exists to be copied.
+ */
+export type InlineCodeKind = 'shell' | 'model' | 'path' | 'token'
+
+/** Shells and the tools a command starts with. Anchored at the string start. */
+const SHELL_TOOLS =
+  /^(?:sudo\s+)?(?:git|gh|npm|pnpm|yarn|bun|npx|node|cargo|rustc|go|python3?|pip3?|uv|poetry|docker|kubectl|helm|terraform|curl|wget|ssh|scp|rsync|brew|make|just|cmake|systemctl|launchctl|defaults|open|code|vim|nano|tmux|cd|ls|cat|head|tail|grep|rg|sed|awk|chmod|chown|mkdir|rm|cp|mv|ln|touch|tar|zip|unzip|kill|ps|lsof|df|du)\b/
+
+/** A leading assignment: `ABLIT=1`, `HF_TOKEN=…`, `FOO=""`. */
+const ENV_ASSIGN = /^[A-Z][A-Z0-9_]{1,40}=\S*$/
+
+/** A runnable script, written relative: `./start.sh`, `../tools/run.py`. A
+ *  `~/…` spelling is a location, not an instruction — it stays a path. */
+const SCRIPT_PATH = /^\.{1,2}\/\S+$/
+
+/** A Hugging Face cache directory: `models--org--name`. */
+const MODEL_CACHE = /^models--[\w.-]+--[\w.-]+/
+
+/** A versioned model or package name: `Qwen3.8-Flash-Next`, `gpt-4o-mini`. */
+const MODEL_NAME = /^[A-Za-z][A-Za-z0-9.]*(?:-\d[\w.-]*|-[A-Z][\w.-]*){1,4}$/
+
+/** At least one slash and no spaces — a filesystem path, not prose. */
+const FILE_PATH = /^(?:~\/|\/|\.{1,2}\/)?[\w.@+-]+(?:\/[\w.@+-]+)+(?:\.[A-Za-z0-9]{1,8})?\/?$/
+
+/** Long, mixed and hyphenated: ids, hashes, keys. */
+const ID_TOKEN = /^(?:gh[pousr]_|sk-|xox[baprs]-)?[A-Za-z0-9][A-Za-z0-9_-]{17,}$/
+
+const HEX_HASH = /^(?:[0-9a-f]{8,}|[0-9A-F]{8,})$/i
+
+/** Decide one span. Order matters: the specific shapes come before the generic. */
+export function classifyInlineCode(raw: string): InlineCodeKind | 'plain' {
+  const text = raw.trim()
+
+  if (!text || /\s{2,}/.test(text)) {
+    return 'plain'
+  }
+
+  if (MODEL_CACHE.test(text)) {
+    return 'model'
+  }
+
+  if (ENV_ASSIGN.test(text) || SHELL_TOOLS.test(text)) {
+    return 'shell'
+  }
+
+  if (SCRIPT_PATH.test(text)) {
+    return 'shell'
+  }
+
+  // Before paths: a hash never contains a slash, and a path always does.
+  if (HEX_HASH.test(text)) {
+    return 'token'
+  }
+
+  if (FILE_PATH.test(text)) {
+    return 'path'
+  }
+
+  if (MODEL_NAME.test(text) && /\d/.test(text)) {
+    return 'model'
+  }
+
+  // Needs a digit or a separator to be an id — a bare word like `ornith` is prose.
+  if (ID_TOKEN.test(text) && /[\d_-]/.test(text)) {
+    return 'token'
+  }
+
+  return 'plain'
+}
+
+/** Whether a span should carry colour at all. */
+export const inlineCodeKind = (raw: string): InlineCodeKind | null => {
+  const kind = classifyInlineCode(raw)
+
+  return kind === 'plain' ? null : kind
+}
