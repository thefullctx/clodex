+/* BRAND MARK — draw-on sweep. A light band crosses the mark once per ~4s and is
+   clipped to the icon's own squircle. NOT masked with the PNG: `mask-image` on
+   a file:// asset resolves to an empty mask in this renderer (the artwork paints
+   as <img>, but the same URL as a CSS mask comes back transparent — verified, the
+   band never showed), and inlining a data: URL would cost a build step for a
+   12px highlight. Clipping to the rounded box is visually the same thing: the
+   band is inside the icon either way, and the corners it cuts are the ones the
+   PNG already leaves transparent. */
+.brand-sweep {
+  position: relative;
+  isolation: isolate;
+  /* The mark PNG is a squircle; a slightly tighter radius keeps the clipped band
+     inside it, so no sliver of light shows on transparent pixels. */
+  border-radius: 22%;
+  overflow: hidden;
+}
+
+.brand-sweep::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  /* Tight, bright pass: a white core with an accent shoulder either side, so it
+     reads on a white squircle and on a dark one without swapping colours. */
+  background-image: linear-gradient(
+    105deg,
+    transparent 46%,
+    rgb(255 255 255 / 0.9) 49%,
+    color-mix(in srgb, var(--ui-accent) 55%, white) 51%,
+    transparent 54%
+  );
+  background-position: 180% 0;
+  background-repeat: no-repeat;
+  background-size: 250% 100%;
+  pointer-events: none;
+  will-change: background-position, opacity;
+  animation: brand-sweep 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
+}
+
+/* 1.1s of travel, then a hold long enough that the repeat reads as a pass of
+   light rather than a shimmer. */
+@keyframes brand-sweep {
+  0% {
+    background-position: 180% 0;
+    opacity: 0;
+  }
+  4% {
+    opacity: 0.95;
+  }
+  28% {
+    background-position: -80% 0;
+    opacity: 0.95;
+  }
+  34%,
+  100% {
+    background-position: -80% 0;
+    opacity: 0;
+  }
+}
+
+/* SIDEBAR STATUS DOT — the busy beat. The row used to wrap a travelling arc
+   around its whole box; the dot now owns the motion: a halo that expands out of
+   the 6px dot and fades, plus a shallow breath on the dot itself so the beat is
+   legible even inside the 14px lead slot (which clips, `overflow-hidden` — the
+   halo is sized to land just inside it, not to fight it). */
+.session-dot-pulse {
+  position: relative;
+  animation: session-dot-beat 1.4s ease-in-out infinite;
+}
+
+.session-dot-pulse::before {
+  content: '';
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: 100%;
+  height: 100%;
+  border-radius: 9999px;
+  background: var(--ui-accent);
+  transform: translate(-50%, -50%) scale(1);
+  animation: session-dot-pulse 1.4s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
+}
+
+@keyframes session-dot-pulse {
+  0% {
+    opacity: 0.75;
+    transform: translate(-50%, -50%) scale(1);
+  }
+  70%,
+  100% {
+    opacity: 0;
+    transform: translate(-50%, -50%) scale(2.1);
+  }
+}
+
+/* The dot BRIGHTENS rather than fades: at 6px on a dark sidebar a tint shift is
+   legible from across the room where an opacity dip just looks like a rendering
+   hiccup. The 12% scale pop is only there to catch the eye on the beat. */
+@keyframes session-dot-beat {
+  0%,
+  100% {
+    background-color: var(--ui-accent);
+    transform: scale(1);
+  }
+  40% {
+    background-color: color-mix(in srgb, var(--ui-accent) 40%, white);
+    transform: scale(1.12);
+  }
+}
+
 @media (prefers-reduced-motion: reduce) {
-  .arc-border::before {
+  .arc-border::before,
+  .brand-sweep::after,
+  .session-dot-pulse,
+  .session-dot-pulse::before {
     animation: none;
   }
 }
