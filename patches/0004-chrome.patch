@@ -42,8 +42,117 @@
         // localStorage unavailable — keep UA defaults.
       }
     </script>
+    <style>
+      /* BOOT SPLASH — the first frame the window ever paints. It lives in the
+         document, not in the React tree: the bundle takes a moment to arrive and
+         the window is shown as soon as a frame exists, so anything that waits
+         for mount is already too late. Dismissed by src/main.tsx on the first
+         painted frame after mount (see dismissBootSplash). */
+      #boot-splash {
+        align-items: center;
+        display: grid;
+        inset: 0;
+        justify-items: center;
+        pointer-events: none;
+        position: fixed;
+        transition: opacity 260ms ease;
+        z-index: 9999;
+      }
+
+      #boot-splash[data-gone] {
+        opacity: 0;
+      }
+
+      .boot-mark {
+        border-radius: 22%;
+        /* 64px to match the connecting overlay's BrandMark: the splash hands off
+           to the overlay, and a size jump between the two would read as a
+           flash rather than one screen. */
+        height: 64px;
+        overflow: hidden;
+        position: relative;
+        width: 64px;
+      }
+
+      .boot-mark img {
+        display: block;
+        height: 100%;
+        object-fit: contain;
+        width: 100%;
+      }
+
+      /* Same draw-on sweep as BrandMark's, on a faster cycle: a boot is 1-2s, so
+         the band has to cross while the splash is still on screen. */
+      .boot-mark::after {
+        animation: boot-sweep 1.5s cubic-bezier(0.4, 0, 0.2, 1) 60ms infinite;
+        background-image: linear-gradient(
+          105deg,
+          transparent 46%,
+          rgb(255 255 255 / 0.9) 49%,
+          color-mix(in srgb, #407bd9 55%, white) 51%,
+          transparent 54%
+        );
+        background-position: 180% 0;
+        background-repeat: no-repeat;
+        background-size: 250% 100%;
+        content: '';
+        inset: 0;
+        position: absolute;
+      }
+
+      @keyframes boot-sweep {
+        0% {
+          background-position: 180% 0;
+          opacity: 0;
+        }
+        8% {
+          opacity: 0.95;
+        }
+        58% {
+          background-position: -80% 0;
+          opacity: 0.95;
+        }
+        70%,
+        100% {
+          background-position: -80% 0;
+          opacity: 0;
+        }
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        .boot-mark::after {
+          animation: none;
+        }
+      }
+    </style>
   </head>
   <body>
+    <!-- Boot splash: painted on the first frame, removed once React has painted. -->
+    <div aria-hidden="true" id="boot-splash">
+      <span class="boot-mark"><img alt="" id="boot-mark-img" /></span>
+    </div>
+    <script>
+      // Same list as TRANSPARENT_WINDOWS (src/lib/transparent-windows.ts) and the
+      // background pre-paint above: a chromeless window must never get a splash.
+      try {
+        const kind = new URLSearchParams(window.location.search).get('win')
+        const splash = document.getElementById('boot-splash')
+
+        if (kind && ['hud', 'overlay', 'quick', 'wake'].indexOf(kind) !== -1) {
+          splash.remove()
+        } else {
+          const scheme =
+            localStorage.getItem('hermes-boot-color-scheme') ||
+            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
+
+          document.getElementById('boot-mark-img').src =
+            scheme === 'dark' ? 'nous-girl-dark.png' : 'nous-girl.png'
+        }
+      } catch {
+        // No storage / no matchMedia: leave the splash without a mark rather than
+        // block the boot.
+      }
+    </script>
     <div id="root" class="scrollbar-dt"></div>
     <script type="module" src="/src/entry.ts"></script>
   </body>
