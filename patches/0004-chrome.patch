diff --git a/apps/desktop/src/app/shell/use-sidebar-column-width.ts b/apps/desktop/src/app/shell/use-sidebar-column-width.ts
new file mode 100644
index 0000000000..d418c48299
--- /dev/null
+++ b/apps/desktop/src/app/shell/use-sidebar-column-width.ts
@@ -0,0 +1,84 @@
+import { type RefObject, useEffect } from 'react'
+
+/**
+ * Publishes the sidebar column's live width as `--sidebar-column-width` on the
+ * shell root.
+ *
+ * The statusbar is one full-width band, but its left stretch sits under the
+ * sidebar and must keep the sidebar's colour; the chrome bands split at this
+ * seam instead of at a hard-coded pixel, so dragging, collapsing or flipping
+ * the column keeps the split aligned with the real panel edge.
+ */
+export function useSidebarColumnWidth(rootRef: RefObject<HTMLElement | null>) {
+  useEffect(() => {
+    const root = rootRef.current
+
+    if (!root) {
+      return
+    }
+
+    let column: HTMLElement | null = null
+    let frame = 0
+    let attempts = 0
+
+    // Publish on the ROOT element, not the shell div: fixed-position titlebar
+    // clusters live in their own stacking/portal context and would otherwise
+    // read the fallback instead of the live column width.
+    const publish = () => {
+      document.documentElement.style.setProperty(
+        '--sidebar-column-width',
+        column ? `${Math.round(column.getBoundingClientRect().width)}px` : '0px'
+      )
+    }
+
+    const observer = new ResizeObserver(publish)
+
+    // The pane tree mounts a beat after the shell; retry on frames until the
+    // sidebar exists, then hand off to the resize observer.
+    const attach = (): boolean => {
+      const next = root.querySelector<HTMLElement>('[data-slot="sidebar"]')
+
+      if (next !== column) {
+        if (column) {
+          observer.unobserve(column)
+        }
+
+        column = next
+
+        if (column) {
+          observer.observe(column)
+        }
+
+        publish()
+      }
+
+      return Boolean(next)
+    }
+
+    const tick = () => {
+      if (attach() || attempts++ > 240) {
+        return
+      }
+
+      frame = requestAnimationFrame(tick)
+    }
+
+    tick()
+    window.addEventListener('resize', publish)
+
+    // Panes close and reopen; a cheap liveness check re-attaches when the
+    // column node is replaced (the resize observer alone would go stale).
+    const interval = window.setInterval(() => {
+      if (!column || !column.isConnected) {
+        attach()
+      }
+    }, 2000)
+
+    return () => {
+      cancelAnimationFrame(frame)
+      window.removeEventListener('resize', publish)
+      window.clearInterval(interval)
+      observer.disconnect()
+    }
+  }, [rootRef])
+}
