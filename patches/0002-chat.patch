+++ b/apps/desktop/src/components/assistant-ui/thread/turn-collapse.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest'
+
+import { liveActivityLabel } from './turn-collapse'
+
+const COPY = { thinking: 'Thinking', thought: 'Thought' }
+
+const reasoning = (status: 'complete' | 'running' = 'running') => ({ status: { type: status }, type: 'reasoning' })
+const text = () => ({ type: 'text' })
+const tool = (toolName: string, args: Record<string, unknown> = {}, settled = false) => ({
+  args,
+  completedAt: settled ? 1 : undefined,
+  result: settled ? { ok: true } : undefined,
+  toolName,
+  type: 'tool-call'
+})
+
+describe('liveActivityLabel', () => {
+  it('narrates a pending call in the present tense, naming it', () => {
+    expect(liveActivityLabel([tool('terminal', { command: 'npm run pack' })], COPY)).toBe('Running npm run pack')
+    expect(liveActivityLabel([tool('vision_analyze', { image_url: 'x.png' })], COPY)).toBe('Analyzing 1 image')
+  })
+
+  it('counts a settled run instead of naming it', () => {
+    expect(
+      liveActivityLabel([tool('terminal', { command: 'ls' }, true), tool('terminal', { command: 'pwd' }, true)], COPY)
+    ).toBe('Ran 2 commands')
+  })
+
+  it('shows only the trailing run — earlier steps are history', () => {
+    expect(
+      liveActivityLabel(
+        [tool('terminal', { command: 'ls' }, true), text(), tool('terminal', { command: 'npm test' })],
+        COPY
+      )
+    ).toBe('Running npm test')
+  })
+
+  it('narrates reasoning while it runs and settles to "Thought"', () => {
+    expect(liveActivityLabel([reasoning('running')], COPY)).toBe('Thinking')
+    expect(liveActivityLabel([reasoning('complete')], COPY)).toBe('Thought')
+  })
+
+  it('says nothing while the tail is prose', () => {
+    expect(liveActivityLabel([reasoning('complete'), text()], COPY)).toBe('')
+    expect(liveActivityLabel([], COPY)).toBe('')
+  })
+})
diff --git a/apps/desktop/src/components/assistant-ui/thread/turn-collapse.tsx b/apps/desktop/src/components/assistant-ui/thread/turn-collapse.tsx
new file mode 100644
index 0000000000..8e290b3c63
--- /dev/null
+++ b/apps/desktop/src/components/assistant-ui/thread/turn-collapse.tsx
@@ -0,0 +1,137 @@
+import { useAuiState } from '@assistant-ui/react'
+import { useStore } from '@nanostores/react'
+import { createContext, type ReactNode, useContext, useRef } from 'react'
+
+import { formatDurationSeconds } from '@/components/assistant-ui/tool/fallback-model/format'
+import { summarizeToolRun, toolActivityTarget, toolPresentVerb, type ToolCallLike } from '@/components/assistant-ui/tool/run-summary'
+import { SCAFFOLD_GLYPH_CLASS, SCAFFOLD_LABEL_CLASS, ScaffoldRow } from '@/components/chat/scaffold-row'
+import { ToolIcon } from '@/components/ui/tool-icon'
+import { useI18n } from '@/i18n'
+import { cn } from '@/lib/utils'
+import { $singleActivity } from '@/store/single-activity'
+import { $toolDisclosureOpen, setToolDisclosureOpen } from '@/store/tool-view'
+
+/**
+ * True while a turn's scaffolding is folded into its single row. The tool and
+ * reasoning renderers return null instead of drawing rows; text parts never
+ * consult it, so the reply itself can never be folded away.
+ */
+export const TurnActivityHiddenContext = createContext(false)
+
+export const useTurnActivityHidden = (): boolean => useContext(TurnActivityHiddenContext)
+
+interface LivePart {
+  completedAt?: number
+  result?: unknown
+  status?: { type?: string }
+  type: string
+}
+
+/**
+ * The one line a live turn shows: what is happening right now.
+ *
+ * The trailing run of tool calls names itself in the present tense while a call
+ * is in flight ("Running npm run pack") and in the past once it settles ("Ran 3
+ * commands"); a reasoning block narrates as "Thinking" until it seals, then
+ * "Thought". Returns '' when the tail is prose — the turn is writing, and there
+ * is nothing to narrate.
+ */
+export function liveActivityLabel(
+  parts: readonly LivePart[],
+  copy: { thinking: string; thought: string }
+): string {
+  let index = parts.length - 1
+  const run: ToolCallLike[] = []
+
+  while (index >= 0 && parts[index]?.type === 'tool-call') {
+    run.unshift(parts[index] as unknown as ToolCallLike)
+    index -= 1
+  }
+
+  if (run.length) {
+    // A single call in flight names what it is doing ("Running npm run pack");
+    // a settled step counts instead ("Ran 3 commands"), which is the reading
+    // that stays useful once the detail is history.
+    if (run.length === 1 && run[0].result === undefined && run[0].completedAt === undefined) {
+      const target = toolActivityTarget(run[0])
+
+      if (target) {
+        return `${toolPresentVerb(run[0].toolName)} ${target}`
+      }
+    }
+
+    return summarizeToolRun(
+      run,
+      run.some(tool => tool.result === undefined && tool.completedAt === undefined)
+    )
+  }
+
+  const last = parts[index]
+
+  if (last?.type === 'reasoning') {
+    return last.status?.type === 'complete' ? copy.thought : copy.thinking
+  }
+
+  return ''
+}
+
+/**
+ * A turn's whole activity as one row, plus the fold that keeps it that way.
+ *
+ * Live, the row narrates the current step and is replaced as the turn moves on;
+ * settled, it becomes "Worked for 2m 14s". Either way it is a disclosure:
+ * opening it restores every thought and tool run in place, interleaved with the
+ * prose. Text is never folded — the answer is always on screen.
+ *
+ * Subscriptions live here, not at the message root: a status flip re-renders
+ * this scope (whose child element identity is stable) and never the transcript
+ * row around it (status-invalidation-scope.test.tsx).
+ */
+export function TurnActivityScope({ children, durationS }: { children: ReactNode; durationS?: number }) {
+  const { t } = useI18n()
+  const messageId = useAuiState(s => s.message.id)
+  const running = useAuiState(s => s.message.status?.type === 'running')
+  const label = useAuiState(s => liveActivityLabel(s.message.parts, t.assistant.thread))
+  const hasActivity = useAuiState(s =>
+    s.message.parts.some(part => part.type === 'tool-call' || part.type === 'reasoning')
+  )
+
+  const disclosureId = `turn:${messageId}`
+  const open = useStore($toolDisclosureOpen(disclosureId))
+  const singleActivityLine = useStore($singleActivity)
+
+  // While the model writes prose the tail is text, so the live label goes empty
+  // for a moment. Remember the last real step instead of flashing back to the
+  // whole stack (or a "Thinking" that is no longer true).
+  const lastLabel = useRef('')
+
+  if (running && label) {
+    lastLabel.current = label
+  }
+
+  const showRow = hasActivity && (running ? singleActivityLine : durationS !== undefined)
+  const fold = showRow && !open
+  const copy = running
+    ? label || lastLabel.current || t.assistant.thread.thinking
+    : durationS !== undefined
+      ? t.assistant.thread.workedFor(formatDurationSeconds(durationS))
+      : ''
+
+  return (
+    <>
+      {showRow && (
+        <div data-conversation-scaffold="" data-slot="turn-activity-row">
+          <ScaffoldRow onToggle={() => setToolDisclosureOpen(disclosureId, !open)} open={Boolean(open)}>
+            <span className={SCAFFOLD_GLYPH_CLASS}>
+              <ToolIcon className="text-(--ui-text-tertiary)" name="watch" size="0.8125rem" />
+            </span>
+            <span className={cn(SCAFFOLD_LABEL_CLASS, 'truncate')}>
+              {running ? <span className="shimmer">{copy}</span> : copy}
+            </span>
+          </ScaffoldRow>
+        </div>
+      )}
+      <TurnActivityHiddenContext.Provider value={fold}>{children}</TurnActivityHiddenContext.Provider>
+    </>
+  )
+}
