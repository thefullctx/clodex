diff --git a/apps/desktop/src/app/chat/sidebar/account-menu.tsx b/apps/desktop/src/app/chat/sidebar/account-menu.tsx
new file mode 100644
index 0000000000..99cb37ee17
--- /dev/null
+++ b/apps/desktop/src/app/chat/sidebar/account-menu.tsx
@@ -0,0 +1,105 @@
+import { useStore } from '@nanostores/react'
+import { ChartColumn, LogOut, PawPrint, Settings, User } from 'lucide-react'
+import { useNavigate } from 'react-router'
+
+import { useGatewayRequest } from '@/app/gateway/hooks/use-gateway-request'
+import avatarUrl from '@/assets/account/avatar.jpg'
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuLabel,
+  DropdownMenuSeparator,
+  DropdownMenuTrigger
+} from '@/components/ui/dropdown-menu'
+import { cn } from '@/lib/utils'
+import { $petGallery, loadPetGallery, setPetEnabled } from '@/store/pet-gallery'
+import { $activeGatewayProfile } from '@/store/profile'
+
+import { COMMAND_CENTER_ROUTE, SETTINGS_ROUTE } from '../../routes'
+
+// The account label follows the active gateway profile instead of a hardcoded
+// handle — a shared build must not name its author.
+const ROW = 'gap-2.5 rounded-md px-2 py-1.5 text-[0.8125rem]'
+
+/**
+ * The account door, bottom-left of the sidebar: avatar, and a menu with the
+ * app's account-level verbs. Every destination is a real surface — Billing for
+ * the account/plan, the Command Center's usage tab for spend, Settings for the
+ * rest, and the Gateway page for the only Sign out this build has.
+ *
+ * "Show Pet" is a live toggle, not a link: it flips the installed pet through
+ * the same action Settings uses.
+ */
+export function AccountMenu() {
+  const navigate = useNavigate()
+  const { requestGateway } = useGatewayRequest()
+  const gallery = useStore($petGallery)
+  const profile = useStore($activeGatewayProfile)
+  const accountName = (profile || '').trim() || 'Local'
+  const petOn = gallery?.enabled ?? false
+
+  const togglePet = async () => {
+    if (!$petGallery.get()) {
+      await loadPetGallery(requestGateway)
+    }
+
+    await setPetEnabled(requestGateway, !petOn, {
+      noneAvailable: 'No pet installed — pick one in Settings → Appearance',
+      fallback: 'Could not change the pet'
+    }).catch(() => false)
+  }
+
+  return (
+    <DropdownMenu>
+      <DropdownMenuTrigger asChild>
+        <button
+          aria-label="Account menu"
+          className={cn(
+            'group/account grid size-8 place-items-center rounded-full p-0 transition',
+            'hover:ring-2 hover:ring-(--ui-control-hover-background) data-[state=open]:ring-2 data-[state=open]:ring-(--ui-stroke-primary)'
+          )}
+          type="button"
+        >
+          <img
+            alt=""
+            className="size-8 rounded-full object-cover ring-1 ring-(--ui-stroke-secondary)"
+            src={avatarUrl}
+          />
+        </button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="start" className="w-56" side="top" sideOffset={8}>
+        <DropdownMenuLabel className="flex items-center gap-2.5 py-1.5">
+          <img alt="" className="size-7 rounded-full object-cover ring-1 ring-(--ui-stroke-secondary)" src={avatarUrl} />
+          <span className="flex min-w-0 flex-col">
+            <span className="truncate text-[0.8125rem] font-medium text-foreground">{accountName}</span>
+            <span className="truncate text-[0.6875rem] text-(--ui-text-tertiary)">Personal</span>
+          </span>
+        </DropdownMenuLabel>
+        <DropdownMenuSeparator />
+        <DropdownMenuItem className={ROW} onSelect={() => navigate(`${SETTINGS_ROUTE}?tab=billing`)}>
+          <User className="size-3.5 text-(--ui-text-tertiary)" />
+          Profile
+        </DropdownMenuItem>
+        <DropdownMenuItem className={ROW} onSelect={() => void togglePet()}>
+          <PawPrint className="size-3.5 text-(--ui-text-tertiary)" />
+          Show Pet
+          <span className="ml-auto text-[0.6875rem] text-(--ui-text-tertiary)">{petOn ? 'On' : 'Off'}</span>
+        </DropdownMenuItem>
+        <DropdownMenuItem className={ROW} onSelect={() => navigate(`${COMMAND_CENTER_ROUTE}?section=usage`)}>
+          <ChartColumn className="size-3.5 text-(--ui-text-tertiary)" />
+          Usage
+        </DropdownMenuItem>
+        <DropdownMenuItem className={ROW} onSelect={() => navigate(SETTINGS_ROUTE)}>
+          <Settings className="size-3.5 text-(--ui-text-tertiary)" />
+          Settings
+        </DropdownMenuItem>
+        <DropdownMenuSeparator />
+        <DropdownMenuItem className={ROW} onSelect={() => navigate(`${SETTINGS_ROUTE}?tab=gateway`)}>
+          <LogOut className="size-3.5 text-(--ui-text-tertiary)" />
+          Log out
+        </DropdownMenuItem>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  )
+}
