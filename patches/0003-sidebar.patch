diff --git a/apps/desktop/src/store/single-activity.ts b/apps/desktop/src/store/single-activity.ts
new file mode 100644
index 0000000000..e5a42b4281
--- /dev/null
+++ b/apps/desktop/src/store/single-activity.ts
@@ -0,0 +1,24 @@
+import { type Codec, persistentAtom } from '@/lib/persisted'
+
+const SINGLE_ACTIVITY_STORAGE_KEY = 'hermes.desktop.singleActivity'
+
+/** Stored as the string 'true'; absent means off. */
+const codec: Codec<boolean> = {
+  decode: raw => raw === 'true',
+  encode: value => (value ? 'true' : null)
+}
+
+/**
+ * Whether a live turn narrates itself as ONE row that is replaced as the work
+ * moves on ("Thinking" → "Running npm run pack" → "Analyzing image") instead of
+ * stacking a row per thought and per tool run.
+ *
+ * Off by default: the stacked feed is the established transcript. On, the whole
+ * activity stays one line for the length of the turn; the stack is still one
+ * disclosure away, and a settled turn folds to "Worked for …" either way.
+ */
+export const $singleActivity = persistentAtom<boolean>(SINGLE_ACTIVITY_STORAGE_KEY, false, codec)
+
+export function setSingleActivity(value: boolean) {
+  $singleActivity.set(value)
+}
diff --git a/apps/desktop/src/store/status-stack-prefs.ts b/apps/desktop/src/store/status-stack-prefs.ts
new file mode 100644
index 0000000000..69199c6e10
--- /dev/null
+++ b/apps/desktop/src/store/status-stack-prefs.ts
@@ -0,0 +1,21 @@
+import { type Codec, persistentAtom } from '@/lib/persisted'
+
+const KEY = 'hermes.desktop.statusStack.attentionOnly'
+
+/** Stored as the string 'true'; absent means off. */
+const codec: Codec<boolean> = {
+  decode: raw => raw === 'true',
+  encode: value => (value ? 'true' : null)
+}
+
+/**
+ * Whether the composer status card shows ONLY what needs the user — queued
+ * turns, background processes, goals/heartbeats, account notices — and drops
+ * the live work rows (subagents, todos, preview artifacts) that narrate a turn
+ * in progress and then vanish.
+ *
+ * Off by default: the full stack is the established composer chrome. On, a
+ * turn's transient activity never pushes a card above the input; the transcript
+ * already narrates it.
+ */
+export const $statusStackAttentionOnly = persistentAtom<boolean>(KEY, false, codec)
