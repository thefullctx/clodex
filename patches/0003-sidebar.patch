@@ -0,0 +1,19 @@
+import { type Codec, persistentAtom } from '@/lib/persisted'
+
+const KEY = 'hermes.desktop.minimalBottomBar'
+
+/** Stored as the string 'true'; absent means off. */
+const codec: Codec<boolean> = {
+  decode: raw => raw === 'true',
+  encode: value => (value ? 'true' : null)
+}
+
+/**
+ * Whether everything below the session list is stripped back to the Command
+ * Center: the profile rail (chips + new/import/manage) goes away, and the
+ * statusbar keeps the ⌘ button alone.
+ *
+ * Off by default — the profile rail and the status chips are the established
+ * chrome. On, the sidebar bottom is one control.
+ */
+export const $minimalBottomBar = persistentAtom<boolean>(KEY, false, codec)
diff --git a/apps/desktop/src/store/open-session-highlight.test.ts b/apps/desktop/src/store/open-session-highlight.test.ts
new file mode 100644
index 0000000000..fe850a9365
--- /dev/null
+++ b/apps/desktop/src/store/open-session-highlight.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, it, beforeEach } from 'vitest'
+
+import { $selectedStoredSessionId } from './session'
+import { $openStoredSessionIds, $parkedTileStoredIds, $sessionTiles } from './session-states'
+
+beforeEach(() => {
+  $selectedStoredSessionId.set(null)
+  $sessionTiles.set([])
+  $parkedTileStoredIds.set(new Set())
+})
+
+describe('$openStoredSessionIds', () => {
+  it('counts the selected session and every mounted tile', () => {
+    $selectedStoredSessionId.set('main')
+    $sessionTiles.set([{ storedSessionId: 'tile-a' }, { storedSessionId: 'tile-b' }])
+
+    expect([...$openStoredSessionIds.get()].sort()).toEqual(['main', 'tile-a', 'tile-b'])
+  })
+
+  // A parked tile is unmounted: nothing of it is on screen, so its sidebar row
+  // must not wear the "open elsewhere" band.
+  it('drops a parked tile from the highlight set', () => {
+    $selectedStoredSessionId.set('main')
+    $sessionTiles.set([{ storedSessionId: 'tile-a' }, { storedSessionId: 'parked' }])
+    $parkedTileStoredIds.set(new Set(['parked']))
+
+    expect([...$openStoredSessionIds.get()].sort()).toEqual(['main', 'tile-a'])
+  })
+
+  it('keeps the selected session highlighted even if a tile for it is parked', () => {
+    $selectedStoredSessionId.set('main')
+    $sessionTiles.set([{ storedSessionId: 'main' }])
+    $parkedTileStoredIds.set(new Set(['main']))
+
+    expect([...$openStoredSessionIds.get()]).toEqual(['main'])
+  })
+})
