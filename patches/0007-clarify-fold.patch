+/** A question waiting on the user is never scaffolding: it IS the turn. Folding
+ *  it away hid the card behind the "Asking a question" row, so the question read
+ *  as a collapsed log line and went unanswered. */
+export function pendingQuestionIn(parts: readonly LivePart[]): boolean {
+  return parts.some(part => {
+    const call = part as unknown as ToolCallLike
+
+    return part.type === 'tool-call' && call.toolName === 'clarify' && call.result === undefined
+  })
+}
