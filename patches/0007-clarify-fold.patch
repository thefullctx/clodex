+
+describe('pendingQuestionIn', () => {
+  // The fold must never swallow a question the turn is waiting on: the card
+  // behind it is the only way to answer, and a collapsed row hid it.
+  it('flags an unanswered clarify call', () => {
+    expect(pendingQuestionIn([tool('clarify', { questions: [] })])).toBe(true)
+  })
+
+  it('lets a settled clarify fold with the rest of the turn', () => {
+    expect(pendingQuestionIn([tool('clarify', {}, true)])).toBe(false)
+  })
+
+  it('ignores ordinary tool calls and prose', () => {
+    expect(pendingQuestionIn([tool('terminal', { command: 'ls' }), text()])).toBe(false)
+  })
+})
